---
import '../styles/global.css';
import { company, seo } from '../data/site';

interface Props {
  /** Per-page. Never share one title across routes — that was audit item 2. */
  title?: string;
  description?: string;
  /** Path with leading and trailing slash, e.g. "/videoproduktion/". */
  path?: string;
}

const { title = seo.title, description = seo.description, path = '/' } = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/img/og.jpg', Astro.site).href;

/*
  LocalBusiness rather than Organization: the buyers are local, "physical
  address in the city of search" is a top-five local-pack factor, and the
  address is the highest-scoring credibility signal we control.

  Note there is deliberately no `telephone` mismatch here — the current site
  ships +46 76 929 85 01 in schema while rendering a placeholder number in
  the contact section, which splits its own NAP.
*/
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.scandicmarketing.se/#business',
  name: company.name,
  url: 'https://www.scandicmarketing.se/',
  telephone: company.phone,
  email: company.email,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.postcode,
    addressLocality: company.city,
    addressRegion: 'Skåne',
    addressCountry: 'SE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 56.0465, longitude: 12.6945 },
  areaServed: [{ '@type': 'City', name: 'Helsingborg' }, { '@type': 'AdministrativeArea', name: 'Skåne' }],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '09:00', closes: '17:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '10:00', closes: '15:00' },
  ],
  sameAs: [company.instagram],
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* No <meta name="keywords">. Google has ignored it since 2009, Bing
        treats it as a spam signal, and on the current site it is 11.4 KB —
        58% of the homepage. */}

    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#001529" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {/* Must actually be 1200×630. The current site declares those dimensions
        for a 1080×314 logo strip, so every share preview is cropped. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a class="sr-only" href="#main">Hoppa till innehåll</a>
    <slot />
  </body>
</html>
