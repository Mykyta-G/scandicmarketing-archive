---
/*
  Scroll-driven flight from a mountain in the far north down to Helsingborg.

  Real terrain, real satellite imagery, one camera. The mountain and the city
  are the same system, so there is no transition to fake between them — you
  simply keep flying.

  Performance is the whole design here. MapLibre is roughly 800 KB, which has
  no business on the critical path of a marketing site, so:
    - the library is dynamically imported, and only once the section is near
    - the map is destroyed again when it leaves
    - rendering is paused whenever the section is off-screen
    - tile sources are capped well below their maximum zoom
    - no labels, no vector layers, no 3D buildings — raster and terrain only

  Everything it loads is free and keyless: AWS Terrarium elevation tiles and
  ESRI World Imagery. ⚠️ ESRI's commercial terms need checking before launch;
  Sentinel-2 is the open fallback if they don't allow it.
*/
const waypoints = [
  // lng, lat, zoom, pitch, bearing
  { c: [16.5997, 68.1615], z: 11.2, p: 62, b: 20, label: 'Stetind' },
  { c: [16.4, 67.4], z: 9.4, p: 68, b: 8, label: '' },
  { c: [15.6, 64.2], z: 7.2, p: 62, b: 4, label: 'Norrland' },
  { c: [14.4, 59.6], z: 6.6, p: 58, b: 0, label: '' },
  { c: [13.2, 57.2], z: 8.4, p: 62, b: -6, label: '' },
  { c: [12.6945, 56.0465], z: 13.6, p: 66, b: -14, label: 'Helsingborg' },
];
---

<section class="jr" id="resa" data-journey data-waypoints={JSON.stringify(waypoints)}>
  <div class="jr__stage">
    <div class="jr__map" data-map></div>

    <div class="jr__scrim" aria-hidden="true"></div>

    <div class="jr__hud">
      <p class="jr__place micro" data-place>Stetind</p>
      <p class="jr__coord" data-coord></p>
    </div>

    <div class="jr__copy">
      <h2 data-jr-h>Vi finns i Norden.<br />Vi jobbar i Helsingborg.</h2>
    </div>

    <p class="jr__credit">Höjddata: AWS Terrain Tiles · Bild: ESRI World Imagery</p>
  </div>

  <noscript>
    <p class="jr__nojs">Den här sektionen är en interaktiv flygning som kräver JavaScript.</p>
  </noscript>
</section>

<style>
  .jr {
    --p: 0;
    position: relative;
    height: 420vh;
    background: var(--ground);
  }

  .jr__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--ground);
  }

  .jr__map {
    position: absolute;
    inset: 0;
    /* The satellite plate is bright and busy; pulling saturation back lets it
       sit in the palette instead of fighting the rest of the page. */
    filter: saturate(0.82) contrast(1.06);
  }

  .jr__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(0 21 41 / 0.55) 0%, rgb(0 21 41 / 0) 26%),
      linear-gradient(to top, rgb(0 21 41 / 0.72) 0%, rgb(0 21 41 / 0) 34%);
  }

  .jr__hud {
    position: absolute;
    left: var(--gutter);
    top: calc(var(--nav-h) + 1.5rem);
    color: var(--on-dark);
    display: grid;
    gap: 0.35rem;
    pointer-events: none;
  }
  .jr__place {
    color: var(--on-dark);
    opacity: 0.9;
  }
  .jr__coord {
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    color: var(--on-dark-2);
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  .jr__copy {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(3.5rem, 10vh, 7rem);
    width: min(100% - 2 * var(--gutter), 42rem);
    pointer-events: none;
  }
  .jr__copy h2 {
    color: var(--on-dark);
    font-size: clamp(1.9rem, 4.6vw, 3.6rem);
    letter-spacing: var(--track-display);
    line-height: 1.02;
    /* Arrives only once the flight is most of the way home. */
    opacity: clamp(0, calc((var(--p) - 0.72) * 5), 1);
    transform: translateY(calc((1 - clamp(0, (var(--p) - 0.72) * 5, 1)) * 14px));
  }

  .jr__credit {
    position: absolute;
    right: var(--gutter);
    bottom: 1rem;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--on-dark-2);
    opacity: 0.4;
  }

  .jr__nojs {
    padding: 4rem var(--gutter);
    color: var(--on-dark-2);
  }

  @media (max-width: 700px) {
    .jr {
      height: 320vh;
    }
    .jr__credit {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jr {
      height: 100svh;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-journey]');
  const holder = document.querySelector<HTMLElement>('[data-map]');
  const placeEl = document.querySelector<HTMLElement>('[data-place]');
  const coordEl = document.querySelector<HTMLElement>('[data-coord]');

  if (section && holder) {
    type WP = { c: [number, number]; z: number; p: number; b: number; label: string };
    const wps: WP[] = JSON.parse(section.dataset.waypoints || '[]');

    let map: any = null;
    let loading = false;
    let visible = false;
    let progress = 0;
    let queued = false;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    /* Ease each leg so the flight settles into a waypoint rather than
       switching direction abruptly at the seam. */
    const easeInOut = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    function sample(p: number) {
      const n = wps.length - 1;
      const x = Math.min(0.9999, Math.max(0, p)) * n;
      const i = Math.floor(x);
      const t = easeInOut(x - i);
      const a = wps[i];
      const b = wps[Math.min(n, i + 1)];
      return {
        center: [lerp(a.c[0], b.c[0], t), lerp(a.c[1], b.c[1], t)] as [number, number],
        zoom: lerp(a.z, b.z, t),
        pitch: lerp(a.p, b.p, t),
        bearing: lerp(a.b, b.b, t),
        label: t < 0.5 ? a.label || b.label : b.label || a.label,
      };
    }

    async function boot() {
      if (map || loading) return;
      loading = true;

      const maplibre = await import('maplibre-gl');
      await import('maplibre-gl/dist/maplibre-gl.css');

      map = new maplibre.Map({
        container: holder,
        /* Raster and terrain only. No labels, no vector tiles, no buildings —
           each of those is another network waterfall for a section the visitor
           passes through in a few seconds. */
        style: {
          version: 8,
          sources: {
            sat: {
              type: 'raster',
              tiles: [
                'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
              ],
              tileSize: 256,
              maxzoom: 16,
              attribution: 'ESRI World Imagery',
            },
            dem: {
              type: 'raster-dem',
              tiles: ['https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png'],
              encoding: 'terrarium',
              tileSize: 256,
              maxzoom: 13,
              attribution: 'AWS Terrain Tiles',
            },
          },
          layers: [
            { id: 'bg', type: 'background', paint: { 'background-color': '#001529' } },
            { id: 'sat', type: 'raster', source: 'sat' },
          ],
          sky: {
            'sky-color': '#7fa8d0',
            'horizon-color': '#dfe8f0',
            'fog-color': '#c9d7e4',
            'fog-ground-blend': 0.6,
          },
          terrain: { source: 'dem', exaggeration: 1.35 },
        } as any,
        ...sample(progress),
        attributionControl: false,
        interactive: false,
        antialias: false,
        /* Half the fragments on retina. On a moving aerial nobody can tell,
           and it roughly halves the GPU cost. */
        pixelRatio: Math.min(devicePixelRatio || 1, 1.5),
        maxZoom: 15,
        fadeDuration: 0,
      });

      map.on('load', () => {
        loading = false;
        apply();
      });
    }

    function apply() {
      if (!map) return;
      const s = sample(progress);
      map.jumpTo({ center: s.center, zoom: s.zoom, pitch: s.pitch, bearing: s.bearing });
      if (placeEl && s.label) placeEl.textContent = s.label;
      if (coordEl) coordEl.textContent = `${s.center[1].toFixed(4)}° N  ${s.center[0].toFixed(4)}° E`;
    }

    function onScroll() {
      const r = section!.getBoundingClientRect();
      const span = r.height - innerHeight;
      progress = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 0;
      section!.style.setProperty('--p', progress.toFixed(4));
      if (!visible || queued) return;
      queued = true;
      requestAnimationFrame(() => {
        apply();
        queued = false;
      });
    }

    /* Boot early enough that tiles are warm by the time it is on screen, and
       tear the whole thing down again once it is well past. A live WebGL map
       left running further down the page is pure battery cost. */
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        if (visible) {
          boot().then(apply);
        } else if (map && Math.abs(e.boundingClientRect.top) > innerHeight * 2) {
          map.remove();
          map = null;
        }
      },
      { rootMargin: '120% 0px 120% 0px' }
    ).observe(section);

    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
