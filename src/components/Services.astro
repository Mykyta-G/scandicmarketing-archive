---
import SectionHead from './SectionHead.astro';
import { services } from '../data/site';
---

<section class="svc" id="tjanster">
  <div class="wrap">
    <SectionHead
      label="02 — Tjänster"
      title="Allt under ett tak."
      lead="Du behöver inte fyra leverantörer som drar åt olika håll. Samma team gör filmen, bilderna, annonserna — och sidan de landar på."
    />

    <ol class="svc__list">
      {
        services.map((s, i) => (
          <li class="svc__row rv">
            <span class="svc__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="svc__name">{s.name}</h3>
            <p class="svc__blurb">{s.blurb}</p>
            <ul class="svc__items">
              {s.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .svc {
    background: var(--surface);
    padding-block: clamp(4rem, 11vh, 8rem);
    border-block: 1px solid var(--rule-12);
  }

  .svc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-12);
  }

  /*
    Rows, not cards. An icon-plus-heading card repeated in a 3-up grid is the
    single most recognisable template signal there is; the row also gives the
    copy somewhere to breathe.
  */
  .svc__row {
    display: grid;
    grid-template-columns: 3.5rem 1fr 1.15fr 14rem;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: start;
    padding-block: clamp(1.5rem, 3.4vh, 2.6rem);
    border-bottom: 1px solid var(--rule-12);
    transition:
      padding-left var(--dur-large) var(--ease-out-quart),
      background var(--dur-large) var(--ease-out-quart);
  }
  @media (hover: hover) {
    .svc__row:hover {
      padding-left: 1rem;
      background: var(--paper);
    }
  }

  .svc__n {
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: var(--track-micro);
    color: var(--ink-4);
    padding-top: 0.5rem;
  }

  .svc__name {
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    font-weight: 700;
    letter-spacing: var(--track-mid);
    color: var(--ink);
  }

  .svc__blurb {
    font-size: var(--t-note);
    color: var(--ink-3);
    line-height: 1.65;
    max-width: 42ch;
  }

  .svc__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .svc__items li {
    font-size: var(--t-micro);
    letter-spacing: 0.01em;
    color: var(--ink-3);
    display: flex;
    gap: 0.55rem;
  }
  .svc__items li::before {
    content: '—';
    color: var(--accent);
  }

  @media (max-width: 980px) {
    .svc__row {
      grid-template-columns: 2.5rem 1fr;
      gap: 0.6rem 1rem;
    }
    .svc__blurb,
    .svc__items {
      grid-column: 2;
    }
    .svc__items {
      grid-template-columns: 1fr 1fr;
      margin-top: 0.4rem;
    }
  }
</style>
