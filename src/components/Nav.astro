---
import { company, nav, hero } from '../data/site';
---

<header class="nav" data-nav>
  {/* A short scrim so the nav has something to sit on over a bright sky,
      without putting a solid bar across the film. */}
  <div class="nav__scrim" aria-hidden="true"></div>

  <div class="nav__in">
    <a class="nav__brand" href="/" aria-label={company.name}>
      <img class="nav__logo nav__logo--light" src="/img/logo-white.webp" alt="" width="480" height="159" />
      <img class="nav__logo nav__logo--dark" src="/img/logo.webp" alt="" width="480" height="159" />
    </a>

    <nav class="nav__links" aria-label="Huvudmeny">
      {nav.map((l) => (
        <a href={l.href}><span>{l.label}</span></a>
      ))}
    </nav>

    <a class="nav__tel" href={`tel:${company.phoneHref}`}>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
      </svg>
      {company.phone}
    </a>

    <a class="btn btn--accent btn--sm nav__cta" href={hero.primary.href}>{hero.primary.label}</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    border-bottom: 1px solid transparent;
    transition:
      background var(--dur-large) var(--ease-out-quart),
      border-color var(--dur-large) var(--ease-out-quart),
      backdrop-filter var(--dur-large) var(--ease-out-quart);
  }

  .nav__scrim {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--nav-h) * 1.9);
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(0 21 41 / 0.55), rgb(0 21 41 / 0));
    transition: opacity var(--dur-large) var(--ease-out-quart);
  }

  /*
    Full bleed — the nav spans the viewport rather than sitting inside the
    1280px content column. Otherwise the logo floats hundreds of pixels in
    from the edge on a wide screen while the hero's scroll cue and pause
    control sit at the true corners, and the two read as different systems.
  */
  .nav__in {
    position: relative;
    padding-inline: clamp(1rem, 2.2vw, 2.25rem);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.4vw, 2.2rem);
  }

  /* ---- logo ---- */
  .nav__brand {
    margin-right: auto;
    display: flex;
    align-items: center;
    position: relative;
  }
  .nav__logo {
    height: 30px;
    width: auto;
    transition:
      height var(--dur-large) var(--ease-out-quart),
      opacity var(--dur-large) var(--ease-out-quart);
  }
  .nav__logo--dark {
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    opacity: 0;
  }

  /* ---- links, with a wipe-up label swap ---- */
  .nav__links {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.9rem);
  }
  .nav__links a {
    display: block;
    overflow: hidden;
    padding: 0.35rem 0.1rem;
    font-size: var(--t-note);
    font-weight: 600;
    color: var(--on-dark);
    transition: color var(--dur-large) var(--ease-out-quart);
  }
  .nav__links span {
    display: block;
    transition: transform var(--dur-enter) var(--ease-out-quart);
  }
  @media (hover: hover) {
    .nav__links a:hover span {
      transform: translateY(-2px);
    }
    .nav__links a:hover {
      color: var(--accent);
    }
  }

  .nav__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--t-note);
    font-weight: 600;
    color: var(--on-dark);
    white-space: nowrap;
    transition: color var(--dur-large) var(--ease-out-quart);
  }
  .nav__tel svg {
    opacity: 0.7;
  }
  @media (hover: hover) {
    .nav__tel:hover {
      color: var(--accent);
    }
  }

  /*
    Navy glow, not an orange one. A coloured shadow under a button of the
    same hue just smears the edge; grounding it in the brand ink makes the
    orange sit on the page instead of bleeding into it.
  */
  .nav__cta {
    box-shadow:
      0 1px 2px rgb(0 21 41 / 0.2),
      0 10px 26px rgb(0 21 41 / 0.38);
  }

  /* ---- past the hero ---- */
  .nav[data-stuck] {
    background: rgb(252 252 253 / 0.9);
    backdrop-filter: blur(16px) saturate(1.5);
    border-bottom-color: var(--rule-12);
  }
  .nav[data-stuck] .nav__scrim {
    opacity: 0;
  }
  .nav[data-stuck] .nav__logo {
    height: 26px;
  }
  .nav[data-stuck] .nav__logo--light {
    opacity: 0;
  }
  .nav[data-stuck] .nav__logo--dark {
    opacity: 1;
  }
  .nav[data-stuck] .nav__links a,
  .nav[data-stuck] .nav__tel {
    color: var(--ink-2);
  }

  @media (max-width: 980px) {
    .nav__links {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .nav__tel span,
    .nav__tel {
      display: none;
    }
  }
</style>
