---
import { clients, clientsLabel, clientsCaption } from '../data/site';

/* Duplicated once so translateX(-50%) lands exactly on a seam — a seamless
   right-to-left loop with no JS and no reflow. */
const track = [...clients, ...clients];
---

<section class="clients" id="samarbeten">
  <div class="wrap">
    <header class="clients__hd rv">
      <p class="clients__lbl">{clientsLabel}</p>
      <span class="clients__rule" aria-hidden="true"></span>
    </header>
  </div>

  <div class="clients__marquee">
    <ul class="clients__track">
      {
        track.map((c, i) => (
          <li class="clients__item" style={`--w:${c.width}px`} aria-hidden={i >= clients.length ? 'true' : undefined}>
            <img src={c.logo} alt={i >= clients.length ? '' : c.name} loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap">
    <p class="clients__cap rv">{clientsCaption}</p>
  </div>
</section>

<style>
  /*
    Hard cut from the film to paper — no gradient between them. The cut is
    where the drama is.
  */
  .clients {
    background: var(--surface);
    padding-block: clamp(3rem, 7vh, 4.5rem);
    border-bottom: 1px solid var(--rule-12);
    overflow: hidden;
  }

  .clients__hd {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 0.85rem;
  }
  .clients__lbl {
    font-size: var(--t-lead);
    font-weight: 500;
    color: var(--ink-3);
  }
  .clients__rule {
    width: 64px;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
  }

  /* ---------- marquee ---------- */
  .clients__marquee {
    margin-block: clamp(1.75rem, 4vh, 3rem);
    position: relative;
    /* Full bleed: the row should read as continuing past the viewport, so it
       escapes the content column and fades at both edges instead of being
       cut off. */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
  }

  .clients__track {
    list-style: none;
    margin: 0;
    padding: 0;

    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);

    width: max-content;
    will-change: transform;
    animation: marquee-left 52s linear infinite;
  }

  /* Pause so it can actually be read, and so the logos are clickable later. */
  .clients__marquee:hover .clients__track,
  .clients__marquee:focus-within .clients__track {
    animation-play-state: paused;
  }

  @keyframes marquee-left {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /*
    Width per logo is the hand-set optical correction carried over from the
    current site — it is why a wide wordmark and a compact roundel read at
    the same weight. Capped against the viewport so a 320px logo doesn't
    dominate a phone.
  */
  .clients__item {
    flex: 0 0 auto;
    width: min(var(--w), 42vw);
    height: clamp(52px, 7.5vw, 92px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .clients__item img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .clients__cap {
    text-align: center;
    font-size: var(--t-note);
    color: var(--ink-3);
  }

  /*
    Reduced motion stops the travel but keeps the row a row — turning it into
    a wrapping stack would be a different component, not a calmer one.
  */
  @media (prefers-reduced-motion: reduce) {
    .clients__track {
      animation: none;
    }
    .clients__marquee {
      overflow-x: auto;
      scrollbar-width: thin;
    }
  }
</style>
