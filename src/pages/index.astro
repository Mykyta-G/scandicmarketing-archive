---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Clients from '../components/Clients.astro';
import { seo } from '../data/site';
---

<Base title={seo.title} description={seo.description} path="/">
  <Nav />

  <main id="main">
    <Hero />
    <Clients />
  </main>
</Base>

<script>
  /* Reveal on scroll — fires once, downward only. The resting state is safe
     if the observer never runs; see .rv in global.css. */
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e, i) => {
        if (!e.isIntersecting) return;
        window.setTimeout(() => e.target.classList.add('is-in'), (i % 6) * 60);
        io.unobserve(e.target);
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
  );
  document.querySelectorAll('.rv').forEach((el) => io.observe(el));
</script>
